@echo off
chcp 65001 >nul
title نظام الفجر لإدارة المبيعات والتقسيط والقروض النقدية - سرفر الشبكة المحلية
color 0A

echo =====================================================================
echo       شركة الفجر للتجارة والتقسيط العام والقروض النقدية
echo             ملف التثبيت والتشغيل التلقائي (Windows Server)
echo =====================================================================
echo.

:: 1. التحقق من وجود Node.js
echo [1/4] التحقق من بيئة التشغيل (Node.js)...
where node >nul 2>nul
if %errorlevel% neq 0 (
    color 0C
    echo [خطأ] برنامج Node.js غير مثبت على هذا الحاسوب!
    echo.
    echo يرجى تحميل وتثبيت Node.js (الإصدار المجاني LTS) من الرابط الرسمي:
    echo https://nodejs.org/
    echo.
    echo بعد تثبيت Node.js، قم بإعادة تشغيل هذا الملف مرة أخرى.
    pause
    exit /b 1
)

node -v
echo [تم] Node.js متوفر وجاهز للعمل.
echo.

:: 2. فحص وتثبيت الحزم المطلوبة
echo [2/4] فحص الحزم والمكتبات البرمجية...
if not exist "node_modules\" (
    echo جاري تحميل وتثبيت الحزم للمرة الأولى (قد يستغرق ذلك دقيقة أو دقيقتين)...
    call npm install
    if %errorlevel% neq 0 (
        color 0C
        echo [خطأ] حدثت مشكلة أثناء تحميل الحزم. تأكد من اتصال الإنترنت وحاول ثانية.
        pause
        exit /b 1
    )
    echo [تم] تم تثبيت الحزم بنجاح.
) else (
    echo [تم] الحزم والمكتبات مثبتة مسبقاً.
)
echo.

:: 3. التأكد من مجلد قاعدة البيانات المحلية
echo [3/4] فحص قاعدة البيانات المحلية...
if not exist "data\" (
    mkdir "data"
)
echo [تم] قاعدة البيانات المحلية جاهزة وآمنة.
echo.

:: 4. تشغيل السيرفر وفتح المتصفح
echo [4/4] جاري تشغيل خادم الشبكة المحلية (Local LAN Server)...
echo.
echo =====================================================================
echo   السيرفر يعمل الآن على المنفذ: 3000
echo   الرابط المحلي على هذا الحاسوب: http://localhost:3000
echo.
echo   للربط مع هواتف أندرويد والحواسيب الأخرى عبر نفس الراوتر:
echo   افتح متصفح الهاتف أو الكمبيوتر واكتب عنوان IP الخاص بهذا الحاسوب:
for /f "tokens=4" %%a in ('route print ^| find " 0.0.0.0 "') do (
    set LOCAL_IP=%%a
)
echo   -> http://%LOCAL_IP%:3000
echo =====================================================================
echo.
echo جاري فتح النظام في المتصفح تلقائياً...
start http://localhost:3000

echo لا تغلق هذه النافذة السوداء أثناء عمل الموظفين على النظام.
echo.
call npm run dev
pause
